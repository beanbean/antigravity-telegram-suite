# ===== Antigravity Telegram Suite Configuration =====
# Copy this file to .env and fill in your values.

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID(s) (send /start to get it)
# For multiple users, separate with commas: 123456,789012
ALLOWED_CHAT_ID=

# CDP Debugging Ports (must match IDE launch args)
# If running both apps side-by-side, use different ports
AGENT_CDP_PORT=9333
IDE_CDP_PORT=9334

# Default AI model to select on new chat / IDE startup
DEFAULT_MODEL=Gemini 3.1 Pro (High)

# Language: en | zh | ko | tr | de | es | fr
LANGUAGE=en

# Optional: Custom projects directory (defaults to ~/Projects)
# PROJECTS_DIR=/home/user/Projects

# ===== Antigravity Dual App Configuration =====
# Preferred active application target: 'agent' (standalone Antigravity) or 'ide' (Antigravity IDE)
ANTIGRAVITY_PREFERRED_APP=ide

# Optional: Custom Windows executable paths
# ANTIGRAVITY_AGENT_PATH=C:\Users\YourUsername\AppData\Local\Programs\Antigravity\Antigravity.exe
# ANTIGRAVITY_IDE_PATH=C:\Users\YourUsername\AppData\Local\Programs\Antigravity-IDE\Antigravity-IDE.exe

# Enable auto-accept module by default when the bot starts
AUTOACCEPT_DEFAULT=true

# ===== Cursor Agent Engine (Telegram → vault nexmeOS) =====
# Binary: ~/.local/bin/agent  (or: /Applications/Cursor.app/.../bin/cursor with subcommand agent)
CURSOR_BIN=/Users/congdau/.local/bin/agent
CURSOR_WORK_DIR=/Users/congdau/Projects/nexmeOS
CURSOR_TIMEOUT=900000
CURSOR_FORCE=true
# Auth Cursor Agent (pick one; pm2 24/7 → prefer API key):
#   1) Same user as pm2: agent login  (session ~/.cursor/, often macOS Keychain)
#   2) CURSOR_API_KEY=...  (Cursor Dashboard → User API Keys; then: pm2 restart telebot --update-env)
# CURSOR_API_KEY=
# Optional: CURSOR_SANDBOX=disabled

# ===== Daily Glass Stage 0 (all OFF by default) =====
DAILY_LOOP_ENABLED=false
DAILY_LOOP_FOCUS_ENABLED=false
DAILY_LOOP_CLOSE_ENABLED=false
DAILY_LOOP_WEEKLY_ENABLED=false
DAILY_LOOP_CAPTURE_ENABLED=false
DAILY_LOOP_HABITS_ENABLED=false
HOTBRAIN_WORKDIR=/Users/congdau/.nexmeos-supabase
DAILY_LOOP_STATE_FILE=/Users/congdau/.telebot/daily-loop.json
DAILY_LOOP_DB_TIMEOUT_MS=15000
# NEXMEOS_VAULT=/absolute/path/to/nexmeOS
